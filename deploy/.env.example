# Copy to deploy/.env and set a domain whose DNS points to your server.
# Empty on purpose: production is not started without an explicit domain.
CEVAMI_DOMAIN=
CEVAMI_DATA_DIR=../.local/deploy-data/v0.1.0
WEB_CONCURRENCY=2
CEVAMI_BACKEND_SUBNET=172.30.80.0/24
CEVAMI_BACKEND_DYNAMIC_RANGE=172.30.80.128/25
CEVAMI_PROXY_IP=172.30.80.2
